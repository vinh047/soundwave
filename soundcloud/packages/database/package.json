{
  "name": "@repo/database",
  "version": "1.0.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "prisma": {
    "seed": "ts-node prisma/seed/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
