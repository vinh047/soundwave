    "prisma:generate": "dotenv -e .env -- prisma generate"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.18.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "dotenv": "^17.2.3"
  }
}
