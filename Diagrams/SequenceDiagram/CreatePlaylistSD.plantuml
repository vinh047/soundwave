@startuml SD

actor "User" as User
participant "View" as View
participant "Controller" as Controller
participant "Service" as Service

title Sequence Diagram: Tạo Playlist cá nhân

autonumber

User -> View: User chọn chức năng Tạo Playlist cá nhân
activate View
View --> View: Hiển thị form tạo Playlist
User -> View: Nhập thông tin Playlist
View --> View: Kiểm tra thông tin Playlist
View -> Controller: Gửi yêu cầu tạo Playlist
activate Controller
Controller -> Service: Xử lý yêu cầu tạo Playlist
activate Service
Service --> Controller: Trả về kết quả tạo Playlist
deactivate Service
alt Tạo Playlist thành công
    Controller --> View: Thông báo "Tạo Playlist thành công"
    View --> View: Tắt form tạo Playlist
else Tạo Playlist thất bại
    Controller --> View: Thông báo "Tạo Playlist thất bại, vui lòng thử lại"
end
deactivate Controller
deactivate View
@enduml