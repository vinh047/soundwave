@startuml Sequence Diagram - Theo Dõi Nghệ Sĩ 

title Sơ Đồ Tuần Tự - Theo Dõi Nghệ Sĩ 

actor "Người dùng" as User
participant ":NextJS Client" as UI
participant ":FollowController" as Controller
participant ":FollowService" as Service
participant ":FollowRepository" as DB
participant ":ArtistRepository" as ArtistDB

autonumber

' === BƯỚC 1: TẢI DANH SÁCH ===
User -> UI: Vào trang "Danh sách nghệ sĩ"
activate UI
UI -> Controller: getAllArtists(artistsDto)
activate Controller

' Lấy userId từ Token
Controller -> Service: getAllArtists(userId)
activate Service

' Lấy danh sách kèm trạng thái isFollowed
Service -> ArtistDB: createQueryBuilder("artist").leftJoinAndSelect("follow", ...).getMany()
activate ArtistDB
ArtistDB --> Service: artistListWithStatus
deactivate ArtistDB

Service --> Controller: {data: artistListWithStatus}
deactivate Service
Controller --> UI: {status: 200, data: ...}
deactivate Controller
UI --> User: Hiển thị danh sách (Nút hiện "Theo dõi" hoặc "Bỏ theo dõi")
deactivate UI

' === BƯỚC 3: TƯƠNG TÁC (TOGGLE) ===
User -> UI: Nhấn nút "Theo dõi" hoặc "Bỏ theo dõi"
activate UI

' Dùng DTO
UI -> Controller: toggleFollow(requestFollowDto)
activate Controller

' Service xử lý logic Toggle
Controller -> Service: toggleFollow(userId, artistId)
activate Service

' === BƯỚC 4 & 5: KIỂM TRA & XỬ LÝ ===
Service -> DB: findOne({ where: { followerId: userId, followingId: artistId } })
activate DB
DB --> Service: existingFollow
deactivate DB

alt Trường hợp 1: Đã theo dõi -> Thực hiện BỎ THEO DÕI (Unfollow)
    Service -> DB: delete({ followerId: userId, followingId: artistId })
    activate DB
    DB --> Service: result
    deactivate DB
    
    alt Dòng sự kiện phụ 1.2: Bỏ theo dõi thất bại
        Service --> Controller: Throw InternalServerError
        Controller --> UI: {status: 500, error: "Unfollow Failed"}
        UI --> User: Thông báo "Bỏ theo dõi thất bại"
    else Thành công
        Service --> Controller: {success: true, status: "unfollowed"}
        
        ' === BƯỚC 6: CẬP NHẬT UI ===
        Controller --> UI: {status: 200, message: "Unfollowed"}
        UI -> UI: Đổi nút thành "Theo dõi"
        UI --> User: Cập nhật trạng thái thành công
    end

else Trường hợp 2: Chưa theo dõi -> Thực hiện THEO DÕI (Follow)
    Service -> DB: save({ followerId: userId, followingId: artistId })
    activate DB
    DB --> Service: newRecord
    deactivate DB
    
    alt Dòng sự kiện phụ 1.1: Theo dõi thất bại
        Service --> Controller: Throw InternalServerError
        Controller --> UI: {status: 500, error: "Follow Failed"}
        UI --> User: Thông báo "Theo dõi thất bại"
    else Thành công
        Service --> Controller: {success: true, status: "followed"}
        deactivate Service
        
        ' === BƯỚC 6: CẬP NHẬT UI ===
        Controller --> UI: {status: 201, message: "Followed"}
        deactivate Controller
        
        UI -> UI: Đổi nút thành "Bỏ theo dõi"
        UI --> User: Cập nhật trạng thái thành công
        deactivate UI
    end
end
@enduml