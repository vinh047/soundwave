@startuml Sequence Diagram - Sửa Playlist Cá Nhân

title Sơ Đồ Tuần Tự - Sửa Playlist Cá Nhân 

actor "Người dùng" as User
participant ":NextJS Client" as UI
participant ":PlaylistController" as Controller
participant ":PlaylistService" as Service
participant ":PlaylistRepository" as PlaylistDB
participant ":PlaylistSongRepository" as SongDB

autonumber

' === BƯỚC 1: TẢI GIAO DIỆN (LOAD DETAIL) ===
User -> UI: Vào trang "Sửa Playlist" (playlistId)
activate UI
UI -> Controller: getPlaylistDetails(playlistId)
activate Controller

' Lấy userId từ Token
Controller -> Service: getPlaylistDetails(userId, playlistId)
activate Service

' Tìm playlist và load relation songs
Service -> PlaylistDB: findOne({ where: { id: playlistId, userId }, relations: ['songs'] })
activate PlaylistDB
PlaylistDB --> Service: playlistEntity (kèm songs)
deactivate PlaylistDB

Service --> Controller: {data: playlistEntity}
deactivate Service
Controller --> UI: {status: 200, data: playlistEntity}
deactivate Controller
UI --> User: Hiển thị danh sách bài hát
deactivate UI

' === BƯỚC 2.3: XÓA BÀI HÁT (MAIN FLOW) ===
User -> UI: Chọn bài hát & Nhấn "Xóa"
activate UI

' [CẬP NHẬT] Dùng RemoveSongDto để chứa songId
' Request: DELETE /playlists/:id/songs (Body: { songId: 123 })
UI -> Controller: removeSongFromPlaylist(playlistId, removedSongFromPlaylistDto)
activate Controller

' Truyền DTO xuống Service
Controller -> Service: removeSongFromPlaylist(userId, playlistId, removedSongFromPlaylistDto)
activate Service

' --- BƯỚC KIỂM TRA QUYỀN (CHECK OWNER) ---
Service -> PlaylistDB: count({ where: { id: playlistId, userId } })
activate PlaylistDB
PlaylistDB --> Service: count
deactivate PlaylistDB

alt Không có quyền (count == 0)
    Service --> Controller: Throw ForbiddenException
    Controller --> UI: {status: 403, error: "Access Denied"}
    UI --> User: Thông báo "Bạn không có quyền sửa Playlist này"
else Có quyền (Hợp lệ)
    ' --- THỰC HIỆN XÓA (Bảng trung gian) ---
    ' Lấy songId từ DTO
    Service -> SongDB: delete({ playlistId, songId: removedSongFromPlaylistDto.songId })
    activate SongDB
    SongDB --> Service: result { affected: N }
    deactivate SongDB
    
    ' === XỬ LÝ DÒNG SỰ KIỆN PHỤ 2.3.1 ===
    alt Xóa thất bại (affected == 0 HOẶC Lỗi DB)
        Service --> Controller: Throw InternalServerError / NotFound
        deactivate Service
        
        Controller --> UI: {status: 500, error: "Delete Failed"}
        deactivate Controller
        
        ' [KHỚP ĐẶC TẢ USECASE 2.3.1]
        UI --> User: Thông báo "Xoá bài hát khỏi Playlist thất bại, vui lòng thử lại"
        deactivate UI
        
    else Xóa thành công (affected > 0)
        ' Đã activate Service ở trên
        Service --> Controller: {success: true}
        deactivate Service
        
        ' === BƯỚC 3: LÀM MỚI (AUTO REFRESH) ===
        Controller --> UI: {status: 200, message: "Removed"}
        deactivate Controller
        
        ' Client tự gọi lại API lấy chi tiết
        UI -> Controller: getPlaylistDetails(playlistId)
        activate Controller
        ' ... (Lặp lại quy trình load như Bước 1) ...
        Controller --> UI: [Playlist mới]
        deactivate Controller
        
        UI --> User: Hiển thị lại danh sách (Đã xóa bài hát)
        deactivate UI
    end
end
@enduml