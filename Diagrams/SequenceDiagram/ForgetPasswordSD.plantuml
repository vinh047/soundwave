@startuml SD

actor "User" as User
participant "View" as View
participant "Controller" as Controller
participant "Service" as Service

title Sequence Diagram: Quên mật khẩu

autonumber

User -> View: User chọn chức năng Quên mật khẩu
activate View
View --> View: Hiển thị form nhập email
User -> View: Nhập email và nhấn Đồng ý
View --> View: Kiểm tra định dạng email
alt Email không hợp lệ
    View --> View: Thông báo "Email không hợp lệ, vui lòng thử lại"
else Email hợp lệ
    View -> Controller: Yêu cầu gửi mã số
    activate Controller
    Controller -> Service: Yêu cầu gửi mã số
    activate Service
    Service --> Controller: Trả về kết quả gửi mã số
    deactivate Service
    Controller --> View: Thông báo "Mã số đã được gửi đến email của bạn"
    deactivate Controller
    View --> User: Hiển thị thông báo
    View --> View: Hiện form nhập mã số
    User -> View: Nhập mã số và nhấn Đồng ý
    View -> Controller: Yêu cầu xác thực mã số
    activate Controller
    Controller -> Service: Yêu cầu xác thực mã số
    activate Service
    Service --> Controller: Trả về kết quả xác thực
    deactivate Service
    alt Mã số không đúng
        Controller --> View: Thông báo "Mã số không đúng, vui lòng thử lại"
        View --> User: Hiển thị thông báo
    else Mã số đúng
        Controller --> View: Thông báo "Xác thực thành công"
        deactivate Controller
        View --> User: Hiển thị thông báo
        View --> View: Hiện form đặt mật khẩu mới
        User -> View: Nhập mật khẩu mới và nhấn Đồng ý
        View -> Controller: Yêu cầu đặt lại mật khẩu
        activate Controller
        Controller -> Service: Yêu cầu đặt lại mật khẩu
        activate Service
        Service --> Controller: Trả về kết quả đặt lại mật khẩu
        deactivate Service
        alt Đặt lại mật khẩu thất bại
            Controller --> View: Thông báo "Đặt lại mật khẩu thất bại, vui lòng thử lại"
            View --> User: Hiển thị thông báo
        else Đặt lại mật khẩu thành công
            Controller --> View: Thông báo "Đặt lại mật khẩu thành công"
            deactivate Controller
            View --> User: Hiển thị thông báo
            View --> User: Chuyển sang giao diện Đăng nhập
        end
    end
end

deactivate View
@enduml