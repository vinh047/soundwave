@startuml SD

actor "User" as User
participant "View" as View
participant "Controller" as Controller
participant "Service" as Service

title Sequence Diagram: Quản lý hồ sơ cá nhân

autonumber

User -> View: User chọn chức năng Quản lý hồ sơ cá nhân
activate View
View -> Controller: Yêu cầu hồ sơ cá nhân
activate Controller
Controller -> Service: Yêu cầu hồ sơ cá nhân
activate Service
Service --> Controller: Trả về hồ sơ cá nhân
deactivate Service
Controller --> View: Hiển thị hồ sơ cá nhân
deactivate Controller

group Sửa hồ sơ cá nhân
    User -> View: Chọn chức năng Sửa hồ sơ (Chuyển sang Usecase Sửa hồ sơ cá nhân)
end
group Xem danh sách và tìm kiếm bài hát yêu thích
    User -> View: Chọn chức năng Xem danh sách bài hát yêu thích (Chuyển sang Usecase Xem danh sách và tìm kiếm bài hát yêu thích)
end
group Tương tác bài hát
    User -> View: Chọn 1 bài hát và nhấn tương tác
    View -> Controller: Yêu cầu xử lý tương tác bài hát
    activate Controller
    Controller -> Service: Yêu cầu xử lý tương tác bài hát
    activate Service
    Service --> Controller: Trả về kết quả xử lý tương tác bài hát
    deactivate Service
    alt Tương tác thất bại
        Controller --> View: Thông báo "Hành động thất bại, vui lòng thử lại"
    else Tương tác thành công
        Controller --> View: Thông báo "Hành động thành công"
    end
    deactivate Controller
    View --> View: Cập nhật số lượt tương tác
end
deactivate View
@enduml