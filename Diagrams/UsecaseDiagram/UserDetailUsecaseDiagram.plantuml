@startuml Sơ Đồ Usecase Chi Tiết User
left to right direction

' Actor
actor "Người dùng" as User

rectangle "Chức năng người dùng" {
    ' Use Case cho mọi người (chưa đăng nhập)
    (Khám phá bài hát) as UC_ExploreSongs
    (Khám phá nghệ sĩ) as UC_ExploreArtists
    (Xem danh sách và tìm kiếm bài hát) as UC_ViewSearchSongs
    (Xem danh sách và tìm kiếm nghệ sĩ) as UC_ViewSearchArtists
    (Nghe nhạc) as UC_Play
    (Đăng ký) as UC_Register
    (Đăng nhập) as UC_Login
    (Quên mật khẩu) as UC_ForgetPassword
    (Cài đặt) as UC_Settings

    ' Use case cần đăng nhập (cho User và Artist)
    (Quản lý hồ sơ cá nhân) as UC_ManageProfile
    (Xem hồ sơ cá nhân) as UC_ViewProfile
    (Sửa hồ sơ cá nhân) as UC_EditProfile

    (Sửa tài khoản cá nhân) as UC_EditAccount
    (Xem danh sách và tìm kiếm bài hát đăng lại) as UC_ViewSearchRepostedSongs

    (Quản lý thư viện cá nhân) as UC_ManageLibrary
    (Xem danh sách và tìm kiếm bài hát yêu thích) as UC_ViewSearchLikedSongs
    (Xem danh sách và tìm kiếm Follower) as UC_ViewSearchFollowers
    (Xem danh sách và tìm kiếm Following) as UC_ViewSearchFollowings
    (Xem và tìm kiếm lịch sử nghe nhạc) as UC_ViewSearchHistory
    
    (Quản lý Playlist cá nhân) as UC_ManagePlaylist
    (Xem danh sách và tìm kiếm Playlist cá nhân) as UC_ViewSearchPlaylists
    (Thêm Playlist cá nhân) as UC_AddPlaylist
    (Xoá Playlist cá nhân) as UC_DeletePlaylist
    (Quản lý chi tiết Playlist cá nhân) as UC_ManagePlaylistDetails
    (Sửa thông tin Playlist) as UC_EditPlaylistInformation
    (Xem danh sách bài hát trong Playlist) as UC_ViewSongsInPlaylist
    (Thêm bài hát vào Playlist) as UC_AddSongsToPlaylist
    (Xoá bài hát khỏi Playlist) as UC_RemoveSongsFromPlaylist

    (Thích bài hát) as UC_Like
    (Bình luận bài hát) as UC_Comment
    (Chia sẻ bài hát) as UC_Share
    (Đăng lại bài hát) as UC_Repost

    (Theo dõi nghệ sĩ) as UC_Follow
    (Báo cáo vi phạm) as UC_Report

    (Quản lý bài hát cá nhân) as UC_ManageSongs
    (Xem danh sách và tìm kiếm bài hát đã tải lên) as UC_ViewSearchUploadedSongs
    (Tải lên bài hát) as UC_AddSongs
    (Sửa thông tin bài hát) as UC_EditSongs
    (Ẩn bài hát) as UC_HideSongs

    ' Use case cho tất cả Actor
    (Đăng xuất) as UC_Logout

    ' -- Mối quan hệ --
    ' Quan hệ <<extend>>
    UC_ForgetPassword ..> UC_Login : <<extend>>

    UC_ViewSearchPlaylists ..> UC_ManagePlaylist: <<extend>>
    UC_AddPlaylist ..> UC_ManagePlaylist: <<extend>>
    UC_DeletePlaylist ..> UC_ManagePlaylist: <<extend>>
    UC_ManagePlaylistDetails ..> UC_ManagePlaylist: <<extend>>

    UC_Like ..> UC_ExploreSongs: <<extend>>
    UC_Comment ..> UC_ExploreSongs: <<extend>>
    UC_Share ..> UC_ExploreSongs: <<extend>>
    UC_Repost ..> UC_ExploreSongs: <<extend>>
    UC_ViewSearchSongs ..> UC_ExploreSongs: <<extend>>
    UC_Play ..> UC_ExploreSongs: <<extend>>

    UC_ViewSongsInPlaylist ..> UC_ManagePlaylistDetails: <<extend>>
    UC_AddSongsToPlaylist ..> UC_ManagePlaylistDetails: <<extend>>
    UC_RemoveSongsFromPlaylist ..> UC_ManagePlaylistDetails: <<extend>>
    UC_EditPlaylistInformation ..> UC_ManagePlaylistDetails: <<extend>>
    
    UC_ViewProfile ..> UC_ManageProfile: <<extend>>
    UC_EditProfile ..> UC_ManageProfile: <<extend>>
    UC_ViewSearchRepostedSongs ..> UC_ManageProfile: <<extend>>
    
    UC_ViewSearchLikedSongs ..> UC_ManageLibrary: <<extend>>
    UC_ViewSearchFollowers ..> UC_ManageLibrary: <<extend>>
    UC_ViewSearchFollowings ..> UC_ManageLibrary: <<extend>>
    UC_ViewSearchHistory ..> UC_ManageLibrary: <<extend>>

    UC_ViewSearchArtists ..> UC_ExploreArtists: <<extend>>
    UC_Follow ..> UC_ExploreArtists: <<extend>>

    UC_AddSongs ..> UC_ManageSongs: <<extend>>
    UC_HideSongs ..> UC_ManageSongs: <<extend>>
    UC_EditSongs ..> UC_ManageSongs: <<extend>>
    UC_ViewSearchUploadedSongs ..> UC_ManageSongs: <<extend>>

    UC_EditAccount ..> UC_Settings: <<extend>>

    ' Quan hệ <<include>> (các chức năng cần đăng nhập)
    UC_ManageProfile ..> UC_Login : <<include>>
    UC_ManageLibrary ..> UC_Login : <<include>>
    UC_ManagePlaylist ..> UC_Login: <<include>>
    UC_ManageSongs ..> UC_Login: <<include>>
    UC_Follow ..> UC_Login : <<include>>
    UC_Report ..> UC_Login : <<include>>
    UC_EditAccount ..> UC_Login : <<include>>
    UC_Like ..> UC_Login : <<include>>
    UC_Comment ..> UC_Login : <<include>>
    UC_Share ..> UC_Login : <<include>>
    UC_Repost ..> UC_Login : <<include>>

    ' -- Gán các actor --
    ' Actor chưa đăng nhập cũng có thể xem và nghe
    User --> UC_ExploreSongs
    User --> UC_ExploreArtists
    User --> UC_Register
    User --> UC_Login
    User --> UC_Logout
    User --> UC_Settings
}