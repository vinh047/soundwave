@startuml Class Diagram Mức Phân Tích - Hệ Thống Nghe Nhạc Trực Tuyến
title Class Diagram Mức Phân Tích - Hệ Thống Nghe Nhạc Trực Tuyến

package "Enums" {
    enum Role {
        USER
        ADMIN
    }

    enum ReportStatus {
        PENDING
        PROCESSED
    }

    enum ReportAction {
        HIDE_SONG
        WARN_USER
        DISMISS
    }

}

' --- ENTITIES ---
package "Database Entities" {
    class User {
        + id: string
        + name: string
        + email: string
        + hashedPassword: string
        + imageUrl: string
        + isLocked: boolean = false
        + role: Role
        + createdAt: Date = now()
        + updatedAt: Date
    }

    class Profile {
        + id: string
        + bio: string
        + location: string
        + userId: string
    }

    class Song {
        + id: string
        + title: string
        + description: string
        + imageUrl: string
        + audioUrl: string
        + duration: number
        + playCount: number
        + isPublic: boolean = true
        + createdAt: Date = now()
        + updatedAt: Date
        + isBanned: boolean = false
        + userId: string
    }

    class PlaylistSong {
        + id: string
        + order: number
        + addedAt: Date = now()
        + playlistId: string
        + songId: string
    }

    class Playlist {
        + id: string
        + title: string
        + description: string
        + isPublic: boolean = true
        + createdAt: Date = now()
        + updatedAt: Date
        + userId: string
    }

    class Like {
        + id: string
        + createdAt: Date = now()
        + userId: string
        + songId: string
    }

    class Comment {
        + id: string
        + content: string
        + createdAt: Date = now()
        + timestamp: number
        + userId: string
        + songId: string
    }

    class Follow {
        + createdAt: Date = now()
        + followerId: string
        + followingId: string
    }

    class Repost {
        + id: string
        + createdAt: Date = now()
        + userId: string
        + songId: string
    }

    class Share {
        + userId: string
        + songId: string
        + platform: string
        + createdAt: Date = now()
    }

    class Report {
        + id: string
        + message: string
        + createdAt: Date = now()
        + reportReasonId: string
        + status: ReportStatus
        + action: ReportAction
        + songId: string
        + reporterId: string
    }

    class ReportReason {
        + id: string
        + reason: string
    }

    class Notification {
        + id: string
        + message: string
        + isRead: boolean = false
        + createdAt: Date = now()
        + receiverId: string
    }
}

' --- RELATIONSHIPS ---

' 1. USER & AUTH
User "1" -- "1" Profile : has >

' 2. FOLLOW
User "1" -- "0..*" Follow : theo dõi >
User "1" -- "0..*" Follow : theo dõi >

' 3. PLAYLIST & SONG
User "1" -- "0..*" Playlist : tạo >
User "1" -- "0..*" Song : tải lên >

' Quan hệ tập hợp: Playlist chứa nhiều bài hát
Playlist "1" *-- "*" PlaylistSong : Chứa
PlaylistSong "*" --> "1" Song : Tham chiếu

' 4. INTERACTIONS
User "1" -- "0..*" Like : thích >
Like "0..*" --> "1" Song : thuộc về >

User "1" -- "0..*" Comment : viết >
Comment "0..*" --> "1" Song : thuộc về >

User "1" -- "0..*" Repost : đăng lại >
Repost "0..*" --> "1" Song : thuộc về >

User "1" -- "0..*" Share : chia sẻ >
Share "0..*" --> "1" Song : thuộc về >

' 5. REPORT SYSTEM
Report "0..*" --> "1" ReportReason : có >
User "1" -- "0..*" Report : báo cáo >
Report "0..*" --> "1" Song : thuộc về >
User "1" -- "0..*" Report : xử lý (Admin) >

' 6. NOTIFICATION
User "1" -- "0..*" Notification : nhận >

@enduml