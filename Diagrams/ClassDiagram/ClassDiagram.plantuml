@startuml Class Diagram Mức Phân Tích - Hệ Thống Nghe Nhạc Trực Tuyến (Updated)
title Class Diagram Mức Phân Tích - Hệ Thống Nghe Nhạc Trực Tuyến

' --- ENUMS (Định nghĩa các tập giá trị cố định) ---
package "Enums" {
    enum Role {
        USER
        ADMIN
    }

    enum SongStatus {
        ACTIVE
        HIDDEN
    }

    enum ReportStatus {
        PENDING
        PROCESSED
        DISMISSED
    }
}

' --- ENTITIES ---
package "Database Entities" {
    class User {
        + id: number
        + name: string
        + email: string
        + password: string
        + imagePath: string
        + isLocked: boolean = false
        + role: Role
        + createdAt: Date = now()
        + updatedAt: Date
    }

    class Profile {
        + id: number
        + bio: string
        + userId: number
    }

    class Song {
        + id: number
        + title: string
        + description: string
        + fileUrl: string
        + imagePath: string
        + status: SongStatus
        + userId: number
        + listenCount: number
        + createdAt: Date = now()
    }

    class Playlist {
        + id: number
        + title: string
        + description: string
        + isPublic: boolean = true
        + userId: number
        + songs: Song[]
    }

    class Like {
        + userId: number
        + songId: number
        + createdAt: Date = now()
    }

    class Comment {
        + id: number
        + content: string
        + userId: number
        + songId: number
        + createdAt: Date = now()
    }

    class Follow {
        + followerId: number
        + followingId: number
        + createdAt: Date = now()
    }

    class Repost {
        + userId: number
        + songId: number
        + createdAt: Date = now()
    }

    class Share {
        + userId: number
        + songId: number
        + platform: string
        + createdAt: Date = now()
    }

    class Report {
        + id: number
        + reason: string
        + status: ReportStatus
        + songId: number
        + reporterId: number
        + createdAt: Date = now()
    }

    class Notification {
        + id: number
        + userId: number
        + message: string
        + isRead: boolean = false
        + createdAt: Date = now()
    }
}

' --- RELATIONSHIPS ---

' 1. USER & AUTH
User "1" -- "1" Profile : has >

' 2. FOLLOW
User "1" -- "0..*" Follow : has followers >
User "1" -- "0..*" Follow : follows >

' 3. PLAYLIST & SONG
User "1" -- "0..*" Playlist : owns >
User "1" -- "0..*" Song : uploads >

' Quan hệ tập hợp: Playlist chứa nhiều bài hát
Playlist "0..*" o-- "0..*" Song : contains >

' 4. INTERACTIONS
User "1" -- "0..*" Like : likes >
Like "0..*" --> "1" Song : target >

User "1" -- "0..*" Comment : writes >
Comment "0..*" --> "1" Song : on >

User "1" -- "0..*" Repost : reposts >
Repost "0..*" --> "1" Song : target >

User "1" -- "0..*" Share : shares >
Share "0..*" --> "1" Song : target >

' 5. REPORT SYSTEM
User "1" -- "0..*" Report : creates (reporter) >
Report "0..*" --> "1" Song : targets >
' Admin xử lý báo cáo (User có role Admin)
User "1" -- "0..*" Report : processes (admin) >

' 6. NOTIFICATION
User "1" -- "0..*" Notification : receives >

@enduml