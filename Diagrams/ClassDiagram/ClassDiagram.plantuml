@startuml Class Diagram Mức Phân Tích - Hệ Thống Nghe Nhạc Trực Tuyến
title Class Diagram Mức Phân Tích - Hệ Thống Nghe Nhạc Trực Tuyến

' --- ENTITIES ---
package "Database Entities" {
    enum Role {
        USER
        ARTIST
        ADMIN
    }

    enum ReportAction {
        HIDE_SONG
        WARN_USER
        DISMISS
    }

    class User {
        + id: string
        + name: string
        + email: string
        + emailVerified: Date
        + password: string
        + role: Role
        + imagePath: string
        + createdAt: Date = now()
        + updatedAt: Date
        + isLocked: boolean = false
    }

    class Profile {
        + id: string
        + bio: string
        + location: string
        + userId: string
    }

    class Song {
        + id: string
        + title: string
        + description: string
        + imagePath: string
        + audioPath: string
        + duration: number
        + playCount: number
        + waveform: json
        + isPublic: boolean = false
        + createdAt: Date = now()
        + updatedAt: Date
        + isBanned: boolean = false
        + userId: string
    }

    class Playlist {
        + id: string
        + title: string
        + description: string
        + isPublic: boolean = false
        + createdAt: Date = now()
        + updatedAt: Date
        + userId: string
        + songs: Song[]
    }

    class Like {
        + userId: string
        + songId: string
        + createdAt: Date = now()
        + songId: string
    }

    class Comment {
        + id: string
        + content: string
        + userId: string
        + songId: string
        + createdAt: Date = now()
        + timestamp: number
    }

    class Follow {
        + followerId: string
        + followingId: string
        + createdAt: Date = now()
    }

    class Repost {
        + userId: number
        + songId: number
        + createdAt: Date = now()
    }
    
    class Share {
        + userId: number
        + songId: number
        + platform: string
        + createdAt: Date = now()
    }

    class Report {
        + id: number
        + message: string
        + reason: string
        + status: string
        + action: ReportAction
        + createdAt: Date = now()
        + songId: string
        + reporterId: string
    }

    class Notification {
        + id: string
        + userId: string
        + message: string
        + isRead: boolean = false
        + createdAt: Date = now()
    }

    class TokenBlacklist {
        + id: string
        + token: string
    }

    class PasswordResetToken {
        + id: string
        + userId: string
        + expiresAt: Date
        + code: string
    }
}

' --- RELATIONSHIPS ---

' 1. USER & PROFILE
User "1" -- "1" Profile : has >

' 2. FOLLOW
User "1" -- "0..*" Follow : has followers (followerId) >
User "1" -- "0..*" Follow : follows (followingId) >

' 3. PLAYLIST & SONG
User "1" -- "0..*" Playlist : owns >
User "1" -- "0..*" Song : uploads (artist) >

Playlist "0..*" o-- "0..*" Song : contains >

' 4. INTERACTIONS (Like, Comment, Repost, Share)
User "1" -- "0..*" Like : likes >
Like "0..*" --> "1" Song : target >

User "1" -- "0..*" Comment : writes >
Comment "0..*" --> "1" Song : on >

User "1" -- "0..*" Repost : reposts >
Repost "0..*" --> "1" Song : target >

User "1" -- "0..*" Share : shares >
Share "0..*" --> "1" Song : target >

' 5. REPORT SYSTEM
User "1" -- "0..*" Report : creates (reporter) >
Report "0..*" --> "1" Song : targets >
User "1" -- "0..*" Report : processes (admin) >

' 6. NOTIFICATION & TOKEN (Bổ sung)
User "1" -- "0..*" Notification : receives >
User "1" -- "0..*" TokenBlacklist : invalidates >

@enduml