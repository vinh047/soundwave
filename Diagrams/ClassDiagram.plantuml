@startuml Class Diagram - Hệ Thống Nghe Nhạc Trực Tuyến
title Class Diagram - Hệ Thống Nghe Nhạc Trực Tuyến

' --- MODULES & LAYERS ---

package "AuthModule" {
    class AuthController {
        + login(dto): Promise<any>
        + register(dto): Promise<any>
        + logout(req): Promise<void>
    }

    class AuthService {
        + validateUser(email, pass): Promise<User>
        + login(user): Promise<{ token }>
        + logout(token): Promise<void>
        + register(dto): Promise<void>
    }

    class PasswordResetController {
        + forgotPassword(dto): Promise<void>
        + resetPassword(dto): Promise<void>
    }

    class PasswordResetService {
        + generateResetCode(email): Promise<void>
        + verifyAndReset(dto): Promise<void>
    }
}

package "UserModule" {
    class UsersService {
        + findOneByEmail(email): Promise<User>
        + create(user): Promise<User>
        + findAll(): Promise<User[]>
        + updateStatus(id, isLocked): Promise<void>
        + warnUser(id): Promise<void>
    }

    class AccountController {
        + getAllAccounts(): Promise<User[]>
        + updateStatus(id, status): Promise<void>
    }

    class ProfileController {
        + getProfile(req): Promise<any>
        + updateProfile(req, dto): Promise<void>
    }
    
    class ProfileService {
        + updateProfile(userId, dto): Promise<void>
        + getProfile(userId): Promise<User>
    }
    
    class FollowController {
        ' [SYNC] Đổi tên thành toggleFollow cho khớp Sequence Diagram
        + toggleFollow(req, dto): Promise<void>
        + getFollowedArtists(req): Promise<Artist[]>
    }
    class FollowService {
        ' [SYNC] Đổi tên thành toggleFollow
        + toggleFollow(userId, artistId): Promise<void>
        + getArtistList(userId): Promise<any[]>
    }
}

package "SongModule" {
    class SongController {
        + uploadSong(req, dto, file): Promise<Song>
        ' [SYNC] Thêm tham số file cho khớp Sequence Sửa Bài Hát
        + updateSong(id, dto, file): Promise<Song>
        + toggleStatus(id, req): Promise<void>
        + getSongStream(id): Promise<Stream>
        + getSongsByArtist(req): Promise<Song[]>
    }

    class SongService {
        + create(userId, dto, fileUrl): Promise<Song>
        ' [SYNC] Thêm tham số file
        + update(userId, songId, dto, file): Promise<void>
        + toggleStatus(songId, artistId): Promise<void>
        + findOne(id): Promise<Song>
        + findAllByArtist(artistId): Promise<Song[]>
        + hideSong(id): Promise<void>
    }
}

package "PlaylistModule" {
    class PlaylistController {
        + create(req, dto): Promise<Playlist>
        + update(id, dto): Promise<void>
        + delete(id, req): Promise<void>
        ' [SYNC] Dùng DTO cho khớp Sequence Thêm Bài Hát
        + addSong(id, dto): Promise<void>
        + removeSong(id, dto): Promise<void>
        + getMyPlaylists(req): Promise<Playlist[]>
    }

    class PlaylistService {
        + create(userId, dto): Promise<Playlist>
        + update(userId, id, dto): Promise<void>
        + remove(userId, id): Promise<void>
        ' [SYNC] Dùng DTO
        + addSong(userId, playlistId, dto): Promise<void>
        + removeSong(userId, playlistId, dto): Promise<void>
        + findAllByUserId(userId): Promise<Playlist[]>
    }
}

package "InteractionModule" {
    class InteractionController {
        + likeSong(req, songId): Promise<void>
        + unlikeSong(req, songId): Promise<void>
        + addComment(req, dto): Promise<Comment>
        + repostSong(req, songId): Promise<void>
        + undoRepost(req, songId): Promise<void>
        + getFavorites(req): Promise<Song[]>
        + searchFavorites(req, keyword): Promise<Song[]>
    }

    class InteractionService {
        + likeSong(userId, songId): Promise<void>
        + unlikeSong(userId, songId): Promise<void>
        + addComment(userId, dto): Promise<Comment>
        + repost(userId, songId): Promise<void>
        + removeRepost(userId, songId): Promise<void>
        + getRepostedSongs(userId): Promise<Repost[]>
        + getFavoriteSongs(userId): Promise<Song[]>
        + searchFavorites(userId, keyword): Promise<Song[]>
    }
}

package "PlayerModule" {
    class PlayerController {
        + playSong(id): Promise<Song>
        + getNextSong(currentId, playlistId): Promise<number>
        + getPreviousSong(currentId, playlistId): Promise<number>
    }
    
    class PlayerService {
        + getSongData(id): Promise<Song>
        + findNextSong(currentId, playlistId): Promise<number>
        + findPreviousSong(currentId, playlistId): Promise<number>
    }
}

package "ReportModule" {
    class ReportController {
        + createReport(req, dto): Promise<void>
        + getPendingReports(): Promise<Report[]>
        + processReport(id, action): Promise<void>
    }

    class ReportService {
        + create(userId, dto): Promise<void>
        + getPendingReports(): Promise<Report[]>
        + processReport(id, action): Promise<void>
    }
}

package "ShareModule" {
    class ShareController {
        + getFriends(platform): Promise<any[]>
        + share(req, dto): Promise<void>
    }
    
    class ShareService {
        + getExternalFriends(userId, platform): Promise<any[]>
        + share(userId, dto): Promise<void>
    }
}

package "SearchModule" {
    class SearchController {
        + getInitialList(): Promise<Song[]>
        + searchSongs(keyword): Promise<Song[]>
        + searchArtists(keyword): Promise<Artist[]>
    }
    class SearchService {
        + getInitialList(): Promise<Song[]>
        + search(keyword, type): Promise<any[]>
    }
}

' --- ENTITIES ---
package "Database Entities" {
    class User {
        + id: number
        + email: string
        + isLocked: boolean
    }

    class TokenBlacklist {
        + id: number
        + token: string
    }

    class Song {
        + id: number
        + title: string
        + status: string
    }

    class Playlist {
        + id: number
        + userId: number
        + songs: Song[]
    }

    class Like {
        + userId: number
        + songId: number
    }

    class Comment {
        + id: number
        + content: string
        + userId: number
        + songId: number
    }

    class Repost {
        + userId: number
        + songId: number
    }
    
    class Share {
        + userId: number
        + songId: number
        + platform: string
    }

    class Report {
        + id: number
        + reason: string
        + status: string
    }
    
    class PasswordResetToken {
        + code: string
        + userId: number
    }
}

' --- EXTERNAL ---
package "Shared" {
    class FileStorageService {
        + getUrl(key): string
    }
    class MailService {
        + sendMail(to, code): void
    }
    class NotificationService {
        + send(userId, msg): void
    }
    class HttpService {
        + get(url): any;
        + post(url, body): any
    }
}

' --- RELATIONSHIPS ---

' Auth & User
AuthController --> AuthService
AuthService ..> UsersService : Use
AuthService ..> TokenBlacklist : Use (Logout)
PasswordResetService ..> UsersService
PasswordResetService ..> MailService
PasswordResetService ..> PasswordResetToken

' Song & Playlist
SongController --> SongService
SongService ..> FileStorageService
SongService ..> Song : InjectRepo

PlaylistController --> PlaylistService
PlaylistService ..> Playlist : InjectRepo
PlaylistService ..> Song : InjectRepo

' Interaction
InteractionController --> InteractionService
InteractionService ..> Like : InjectRepo
InteractionService ..> Comment : InjectRepo
InteractionService ..> Repost : InjectRepo
InteractionService ..> Song : InjectRepo (Search/Fav)

' Share & Search
ShareController --> ShareService
ShareService ..> Share : InjectRepo
ShareService ..> HttpService : Use (External API)

SearchController --> SearchService
SearchService ..> Song : InjectRepo
SearchService ..> User : InjectRepo (Artist)

' Player
PlayerController --> PlayerService
PlayerService ..> Song : InjectRepo (Find Next/Prev)
PlayerService ..> FileStorageService

' Report & Admin
ReportController --> ReportService
ReportService ..> Report : InjectRepo
ReportService ..> SongService : Use (Hide Song)
ReportService ..> UsersService : Use (Warn User)
ReportService ..> NotificationService : Use

' Profile
ProfileController --> ProfileService
ProfileController --> InteractionService : Use (Get Reposts)

' Entity Relations
User "1" -- "0..*" Playlist
User "1" -- "0..*" Song
Playlist "0..*" -- "0..*" Song
Song "1" -- "0..*" Like
Song "1" -- "0..*" Comment
Song "1" -- "0..*" Repost
Song "1" -- "0..*" Share
Song "1" -- "0..*" Report

@enduml