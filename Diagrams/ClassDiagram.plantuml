@startuml Class Diagram - NestJS Backend Updated
title Class Diagram - Hệ thống nghe nhạc (NestJS + MySQL)

' --- CẤU TRÚC DTO (Data Transfer Objects) ---
package "DTOs (Input Validation)" {
    class LoginDto {
        + email: string
        + password: string
    }
    
    class CreateSongDto {
        + title: string
        + genre: string
        + description: string
    }
    
    class UpdateProfileDto {
        + fullName: string
        + bio: string
        + avatarUrl: string
    }

    class CreatePlaylistDto {
        + name: string
        + description: string
    }

    class RequestFollowDto {
        + artistId: number
    }

    ' [MỚI] DTO cho chức năng Quên mật khẩu
    class ForgotPasswordDto {
        + email: string
    }

    ' [MỚI] DTO cho chức năng Đặt lại mật khẩu
    class ResetPasswordDto {
        + code: string
        + newPassword: string
    }
}

' --- CẤU TRÚC MODULES ---

package "AuthModule" {
    class AuthController {
        + login(dto: LoginDto): Promise<any>
        + register(dto: RegisterDto): Promise<any>
        + logout(req: Request): Promise<void>
    }

    class AuthService {
        ' [CẬP NHẬT] Logic Login gọi UsersService
        + validateUser(email: string, pass: string): Promise<User>
        + login(user: User): Promise<{ access_token: string }>
        + register(user: User): Promise<User>
        ' [CẬP NHẬT] Logout xử lý blacklist token
        + logout(userId: number, token: string): Promise<void>
    }

    ' [MỚI] Controller riêng cho Password Reset
    class PasswordResetController {
        + forgotPassword(dto: ForgotPasswordDto): Promise<void>
        + resetPassword(dto: ResetPasswordDto): Promise<void>
    }

    ' [MỚI] Service xử lý logic quên mật khẩu
    class PasswordResetService {
        + generateResetCode(email: string): Promise<void>
        + verifyAndReset(dto: ResetPasswordDto): Promise<void>
    }
    
    class JwtStrategy {
        + validate(payload: any): Promise<User>
    }
}

package "UserModule" {
    ' [MỚI] Service chung để thao tác với bảng User (dùng cho Auth)
    class UsersService {
        + findOneByEmail(email: string): Promise<User>
        + create(user: User): Promise<User>
    }

    class ProfileController {
        + getProfile(req): Promise<Profile>
        + updateProfile(req, dto: UpdateProfileDto): Promise<UpdateResult>
    }
    
    class ProfileService {
        + updateProfile(userId: number, dto: UpdateProfileDto): Promise<void>
    }
    
    class FollowController {
        + requestFollow(req, dto: RequestFollowDto): Promise<void>
        + getFollowedArtists(req): Promise<Artist[]>
    }
    
    class FollowService {
        + followArtist(userId: number, artistId: number): Promise<void>
        ' [CẬP NHẬT] Cần userId để check trạng thái follow
        + getArtistList(userId: number): Promise<any[]> 
    }
}

package "SongModule" {
    class SongController {
        + uploadSong(req, dto: CreateSongDto, file: Express.Multer.File): Promise<Song>
        + getSongStream(id: number): Promise<StreamableFile>
        + playSong(id: number): Promise<Song>
    }

    class SongService {
        ' [CẬP NHẬT] Luôn truyền userId
        + create(userId: number, dto: CreateSongDto, fileUrl: string): Promise<Song>
        + findOne(id: number): Promise<Song>
        + getStreamUrl(id: number): Promise<string>
    }
}

package "PlaylistModule" {
    class PlaylistController {
        + create(req, dto: CreatePlaylistDto): Promise<Playlist>
        + addSong(id: number, songId: number, req): Promise<void>
        + removeSong(id: number, songId: number, req): Promise<void>
        + delete(id: number, req): Promise<void>
    }

    class PlaylistService {
        ' [CẬP NHẬT] Luôn truyền userId
        + create(userId: number, dto: CreatePlaylistDto): Promise<Playlist>
        + addSongToPlaylist(userId: number, playlistId: number, songId: number): Promise<void>
        + removeSongFromPlaylist(userId: number, playlistId: number, songId: number): Promise<void>
        + checkOwner(userId: number, playlistId: number): Promise<boolean>
    }
}

' --- ENTITIES (TypeORM / MySQL Tables) ---
package "Database Entities (TypeORM)" {
    enum Role {
        USER
        ARTIST
        ADMIN
    }

    class User {
        + id: number
        + email: string
        + password: string
        + role: Role
        + playlists: Playlist[]
        + songs: Song[]
        + followedArtists: Artist[]
    }

    ' [MỚI] Entity lưu mã xác thực quên mật khẩu
    class PasswordResetToken {
        + id: number
        + code: string
        + userId: number
        + expiresAt: Date
    }

    class Artist extends User {
        + verifiedAt: Date
    }

    class Song {
        + id: number
        + title: string
        + fileUrl: string
        + userId: number
        + user: User
        + playlists: Playlist[]
    }

    class Playlist {
        + id: number
        + name: string
        + userId: number
        + user: User
        + songs: Song[]
    }
}

' --- EXTERNAL SERVICES ---
package "Shared / Common" {
    interface FileStorageService {
        + upload(file: Buffer): Promise<string>
        + getUrl(key: string): string
    }

    ' [MỚI] Service gửi email
    class MailService {
        + sendMail(to: string, code: string): Promise<void>
    }
}

' --- RELATIONSHIPS ---

' Auth Dependency
AuthController --> AuthService
AuthService ..> UsersService : [Mới] Use
AuthService ..> JwtStrategy

' Password Reset Dependency [Mới]
PasswordResetController --> PasswordResetService
PasswordResetService ..> UsersService : Use (Find user)
PasswordResetService ..> MailService : Use (Send mail)
PasswordResetService ..> PasswordResetToken : InjectRepository

' Song Dependency
SongController --> SongService
SongService ..> FileStorageService
SongService ..> Song : InjectRepository

' Playlist Dependency
PlaylistController --> PlaylistService
PlaylistService ..> Playlist : InjectRepository
PlaylistService ..> Song : InjectRepository

' User/Profile Dependency
ProfileController --> ProfileService
ProfileService ..> User : InjectRepository

FollowController --> FollowService
FollowService ..> User : InjectRepository

' Entity Relationships
User "1" *-- "0..*" Playlist : OneToMany
Playlist "0..*" *-- "0..*" Song : ManyToMany
User "1" *-- "0..*" Song : OneToMany (Artist uploads)
User "0..*" *-- "0..*" Artist : ManyToMany (Follows)
User "1" -- "0..*" PasswordResetToken : OneToMany

@enduml